{
  // Type-checks the service worker (src/sw.ts) against worker globals instead of the DOM.
  // Run with: npx tsc --noEmit -p tsconfig.sw.json
  "include": ["src/sw.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true
  }
}
